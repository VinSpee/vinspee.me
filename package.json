{
  "name": "vinspee.me",
  "description": "vince speelman's website (migrated to Qwik + Qwik City)",
  "version": "4.0.0",
  "private": true,
  "author": "Vince Speelman <v@vinspee.me>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noahg/gatsby-starter-blog-no-styles.git"
  },
  "homepage": "https://github.com/noahg/gatsby-starter-blog-no-styles#readme",
  "keywords": [
    "qwik",
    "qwik-city",
    "vite",
    "static-site",
    "ssr",
    "panda-css"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "predev": "panda codegen && panda build",
    "prestart": "panda codegen && panda build",
    "prebuild": "panda codegen && panda build",
    "dev": "vite",
    "start": "vite",
    "build": "npm run build.client && npm run build.ssr && npm run build.types",
    "build.client": "QWIK_BUILD=client vite build",
    "build.ssr": "QWIK_BUILD=ssr vite build --ssr src/entry.ssr.tsx --outDir dist/server",
    "build.types": "tsc --incremental false --noEmit",
    "preview": "qwik preview",
    "panda": "panda --watch",
    "lint": "echo 'No lint configured'",
    "test": "echo \"No tests configured\" && exit 0"
  },
  "dependencies": {
    "@builder.io/qwik": "^1.5.6",
    "@builder.io/qwik-city": "^1.5.6"
  },
  "devDependencies": {
    "@pandacss/dev": "^0.37.0",
    "typescript": "^5.4.0",
    "vite": "^5.1.0",
    "eslint": "^8.57.0"
  }
}
